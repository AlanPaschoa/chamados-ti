<%- include('../partials/header') %>

<header class="page-header">
  <div>
    <h1>Gestão de Usuários</h1>
    <p class="subtitle">Visualize os usuários cadastrados e altere o perfil de acesso.</p>
  </div>
</header>

<section class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Perfil atual</th>
          <th>Alterar perfil</th>
        </tr>
      </thead>
      <tbody>
        <% usuarios.forEach(function (u) { %>
          <tr>
            <td><strong><%= u.nome %></strong></td>
            <td><%= u.email %></td>
            <td><span class="badge badge-blue"><%= u.perfil %></span></td>
            <td>
              <% if (u.uid !== user.uid) { %>
                <form method="POST" action="/users/<%= u.uid %>/perfil?_method=PATCH" style="display:flex; gap:.5rem;">
                  <select name="perfil">
                    <% PERFIS.forEach(function (p) { %>
                      <option value="<%= p %>" <%= u.perfil === p ? 'selected' : '' %>><%= p %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn btn-primary">Salvar</button>
                </form>
              <% } else { %>
                <span class="muted">(você)</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/footer') %>