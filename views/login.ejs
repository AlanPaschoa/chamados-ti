<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Entrar · HelpDesk TI</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; }
    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 1rem;
      font-family: 'Inter', system-ui, sans-serif;
      background: linear-gradient(135deg, #1e1b4b, #4338ca);
      color: #111827;
    }
    .login-card {
      width: 100%;
      max-width: 400px;
      padding: 2rem;
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 20px 50px rgba(0, 0, 0, .3);
    }
    h1 { font-size: 1.6rem; text-align: center; color: #111827; }
    .sub { text-align: center; color: #6b7280; font-size: .9rem; margin: .25rem 0 1.5rem; }
    label { display: block; margin-top: 1rem; font-size: .85rem; font-weight: 500; color: #374151; }
    input {
      width: 100%;
      padding: .7rem .8rem;
      margin-top: .3rem;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font: inherit;
      color: #111827;
      background: #fff;
    }
    input:focus { outline: 2px solid #6366f1; border-color: transparent; }
    button {
      width: 100%;
      padding: .75rem;
      margin-top: .75rem;
      border-radius: 8px;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
    }
    #btn-entrar { background: #4f46e5; color: #fff; margin-top: 1.25rem; }
    #btn-entrar:hover { background: #4338ca; }
    #btn-criar { background: #fff; color: #4f46e5; border-color: #4f46e5; }
    #btn-criar:hover { background: #eef2ff; }
    #btn-google { background: #fff; color: #374151; border-color: #d1d5db; }
    #btn-google:hover { background: #f3f4f6; }
    .divisor { display: flex; align-items: center; gap: .75rem; margin: 1.25rem 0 .25rem; color: #9ca3af; font-size: .8rem; }
    .divisor::before, .divisor::after { content: ''; flex: 1; height: 1px; background: #e5e7eb; }
    #msg { display: none; margin-top: 1rem; padding: .7rem; border-radius: 8px; background: #fee2e2; color: #991b1b; font-size: .9rem; }
  </style>
</head>
<body>
  <main class="login-card">
    <h1>HelpDesk TI</h1>
    <p class="sub">Entre ou crie sua conta para continuar</p>

    <form id="form">
      <label>Nome (apenas para criar conta)
        <input type="text" id="nome" autocomplete="name" placeholder="Seu nome completo">
      </label>
      <label>E-mail
        <input type="email" id="email" required autocomplete="email" placeholder="voce@empresa.com">
      </label>
      <label>Senha
        <input type="password" id="senha" required minlength="6" autocomplete="current-password" placeholder="Mínimo de 6 caracteres">
      </label>
      <button type="submit" id="btn-entrar">Entrar</button>
      <button type="button" id="btn-criar">Criar conta</button>
    </form>

    <div class="divisor">ou</div>
    <button type="button" id="btn-google">Entrar com Google</button>

    <div id="msg" role="alert"></div>
  </main>
  <script type="module" src="/js/login.js"></script>
</body>
</html>